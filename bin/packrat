#!/usr/bin/env bash
# The packrat CLI for Claude Code. A packrat already on the PATH is used; otherwise the newest
# release is downloaded once, checked against the release's checksums.txt, and kept in the cache.
# packrat update replaces the cached copy in place.
set -euo pipefail

REPO="packratlabs/packrat-cli"

here="$(cd "$(dirname "$0")" && pwd)"
IFS=: read -r -a dirs <<< "${PATH:-}"
for dir in "${dirs[@]}"; do
  [ -n "$dir" ] && [ "$(cd "$dir" 2>/dev/null && pwd)" != "$here" ] && [ -x "$dir/packrat" ] && exec "$dir/packrat" "$@"
done

cache="${XDG_CACHE_HOME:-$HOME/.cache}/packrat/cli"
binary="$cache/packrat"
if [ ! -x "$binary" ]; then
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m)
  case "$arch" in x86_64|amd64) arch=amd64 ;; arm64|aarch64) arch=arm64 ;; *) echo "packrat: no release for $arch" >&2; exit 1 ;; esac
  case "$os" in darwin|linux) ;; *) echo "packrat: no release for $os here; install it from https://github.com/$REPO/releases" >&2; exit 1 ;; esac

  archive="packrat_${os}_${arch}.tar.gz"
  base="https://github.com/$REPO/releases/latest/download"
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  echo "packrat: downloading the newest packrat, one time" >&2
  curl -fsSL "$base/$archive" -o "$work/$archive"
  curl -fsSL "$base/checksums.txt" -o "$work/checksums.txt"
  want=$(awk -v name="$archive" '$2 == name { print $1 }' "$work/checksums.txt")
  if command -v shasum >/dev/null; then got=$(shasum -a 256 "$work/$archive" | awk '{ print $1 }'); else got=$(sha256sum "$work/$archive" | awk '{ print $1 }'); fi
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    echo "packrat: $archive does not match checksums.txt, so it was not installed" >&2
    exit 1
  fi
  tar -xzf "$work/$archive" -C "$work" packrat
  mkdir -p "$cache"
  mv "$work/packrat" "$binary"
  chmod +x "$binary"
fi
exec "$binary" "$@"
